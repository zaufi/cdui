#
# Read about the file format here: https://editorconfig.org/#file-format-details
#

root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.yaml]
indent_size = 2

[*.{bash,sh}{,.in}]
binary_next_line = true
function_next_line = true
keep_padding = true
space_redirects = true
switch_case_indent = true
