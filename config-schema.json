{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/plugin-config.schema.json",
  "title": "Plugin Configuration",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "colors": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "url": {
          "type": "string"
        },

        "current-url": {
          "type": "string"
        },

        "missed-url": {
          "type": "string"
        }
      }
    },

    "plugins": {
      "type": "object",
      "additionalProperties": false,

      "patternProperties": {
        "^[a-z0-9][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": false,

          "properties": {
            "enable": {
              "type": "boolean"
            },

            "order": {
              "type": "integer",
              "minimum": 1
            },

            "hotkey": {
              "type": "string",
              "pattern": "^CTRL-[A-Z]$"
            },

            "colors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
